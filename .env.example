# Directories (absolute or relative to the working directory the binary runs in)
SOURCE_DIR='../athena-source'          # immutable read-only clone to extract from
DEST_DIR='../athena-gitops'            # GitOps repo workloads get written to
CLUSTER_APPS_DIR='../athena-gitops/cluster/apps'  # where ArgoCD App-of-Apps manifests go
TALOS_TEMPLATE_DIR='../talos-templates'            # *.template.yaml files for render-talos

# 1password item IDs
OP_TALOS_ITEM_ID='abcdefg123456'
REGISTRY_1P_ITEM_ID='abcdefg123456'

# Situational config
SOURCE_ENV='dev1'
TARGET_ENVS='dev2,dev3'
APP_PATTERN='wtf-*' # Assuming your kustomize manifest is layed out like some_dir/wtf-app1 and .../wtf-app2 etc
PROJECT_NAME='wtf'

# URLS and hosts
REGISTRY_HOSTNAME='container-registry.fqdn.example.com'
TLD='my.fancy.tld'
# The workloads repo the generated ApplicationSet points ArgoCD at (its
# per-app overlay dirs become the "<app>/overlay/<env>" source path) - NOT
# this GitOps repo (that's DEST_DIR/CLUSTER_APPS_DIR above).
REPO_URL='https://github.com/abradner/wtf-workloads.git'

# Keycloak admin bootstrap credentials (setup-keycloak only) - both default to 'admin' if unset
KEYCLOAK_ADMIN='admin'
KEYCLOAK_ADMIN_PASSWORD='admin'
