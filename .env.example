# Directories (absolute or relative to the working directory the binary runs in)
SOURCE_DIR='../athena-source'          # immutable read-only clone to extract from
DEST_DIR='../wtf-workloads'            # clone of REPO_URL below; `sync` writes app overlays here
CLUSTER_APPS_DIR='../athena-gitops/cluster/apps'  # separate GitOps repo; where the ApplicationSet goes
TALOS_TEMPLATE_DIR='../talos-templates'            # *.template.yaml files for render-talos

# 1Password
#
# Vault that sync-1p writes its per-environment Secure Notes into. Required for
# sync-1p and prune-1p only. Without it `op` silently files items in the
# account's PERSONAL vault -- no error, no warning -- so sync-1p refuses to run
# with it unset.
OP_VAULT_NAME='Tooling - Athena'

# Secure Note holding the Talos secrets.yaml, read by render-talos. Not
# enforced at startup: omitting it fails later inside `op` with an empty item
# ID rather than at config load.
OP_TALOS_ITEM_ID='abcdefg123456'

# Item backing the registry pull-secret ExternalSecret that `sync` injects.
REGISTRY_1P_ITEM_ID='abcdefg123456'

# AWS
#
# Secrets that do not follow the environment naming convention, and so are
# invisible to the name filter sync-1p uses -- the ElastiCache credentials
# below being the live example. Comma-separated, exact names.
# "{{source_env}}" is expanded from SOURCE_ENV. A named secret that does not
# exist is skipped with a warning; any other AWS error fails the run.
ADDITIONAL_EXACT_SECRETS='dev/neons-dev-elasticache/pmn-{{source_env}}-ro,dev/neons-dev-elasticache/pmn-{{source_env}}-rw'

# Situational config
SOURCE_ENV='dev1'
TARGET_ENVS='dev2,dev3'
APP_PATTERN='wtf-*' # Assuming your kustomize manifest is layed out like some_dir/wtf-app1 and .../wtf-app2 etc
PROJECT_NAME='wtf'

# URLS and hosts
REGISTRY_HOSTNAME='container-registry.fqdn.example.com'
TLD='my.fancy.tld'
# The workloads repo `sync` commits into (DEST_DIR is its local clone) and
# the generated ApplicationSet points ArgoCD's per-app "<app>/overlay/<env>"
# source path at - NOT the GitOps repo CLUSTER_APPS_DIR lives in.
REPO_URL='https://github.com/abradner/wtf-workloads.git'

# Keycloak admin bootstrap credentials (setup-keycloak only) - both default to 'admin' if unset
KEYCLOAK_ADMIN='admin'
KEYCLOAK_ADMIN_PASSWORD='admin'
