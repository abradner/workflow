.env
.env.*
coverage/

# Local extraction/debug dumps. These hold decrypted AWS Secrets Manager
# payloads in plaintext and must never be committed.
.aws_secrets_dump.json
*.secrets.json

# Local clones of the source/workloads repo, kept alongside for convenience
pmn-kustomize/
*-workloads/

# Agent tooling. The shared steering files (AGENTS.md, CLAUDE.md) are tracked;
# per-developer local overrides are not.
.claude/settings.local.json

# Scratch output from agent tooling that writes into the working directory
# rather than a temp dir. Caught at `git add` once; ignored so it cannot be
# committed by a broad add next time.
diagram.json
diagram.mermaid

# Editor / IDE
.idea/
.vscode/
