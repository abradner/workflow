# Directories
SOURCE_DIR='/path/to/source/workloads'           # Read-only source repo (e.g. a clone of pmn-workloads)
DEST_DIR='/path/to/dest/workloads'               # GitOps destination for rendered manifests
CLUSTER_APPS_DIR='/path/to/gitops/cluster/apps'  # ArgoCD Application manifest output dir
TALOS_TEMPLATE_DIR='/path/to/talos/templates'    # Directory containing *.template.yaml files

# Environment mapping
SOURCE_ENV='dev1'                    # Environment to extract secrets/configs from
TARGET_ENVS='dev2,dev3'              # Comma-separated target environments
APP_PATTERN='wtf-*'                  # Glob for discovering Kustomize apps in SOURCE_DIR
PROJECT_NAME='wtf'                   # Namespace prefix: <project>-<env>
TLD='my.fancy.tld'                   # Top-level domain for generated routes/hostnames

# Comma-separated list for AWS exact extraction
ADDITIONAL_EXACT_SECRETS='some/unexpected/path-#{source_env}-ro,some/unexpected/path-#{source_env}-rw'

# Registry
REGISTRY_HOSTNAME='container-registry.fqdn.example.com'
REGISTRY_1P_ITEM_ID='abcdefg123456'  # 1Password item ID for registry pull-secret

# 1Password
OP_VAULT_NAME='Tooling'              # Target vault for sync-1p upserts
OP_TALOS_ITEM_ID='abcdefg123456'     # Secure Note item ID for render-talos

# Git
REPO_URL='https://github.com/org/gitops.git'  # Used by setup-argo for Application spec

# Keycloak (optional — defaults to 'admin' if unset)
# KEYCLOAK_ADMIN='admin'
# KEYCLOAK_ADMIN_PASSWORD='admin'
